{
  "name": "nexa-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~55.0.27",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "ELECTRON_DISABLE_SANDBOX=1 ANDROID_HOME=${ANDROID_HOME:-/usr/lib/android-sdk} expo start --clear",
    "android": "ELECTRON_DISABLE_SANDBOX=1 ANDROID_HOME=${ANDROID_HOME:-/usr/lib/android-sdk} expo start --android --clear",
    "ios": "expo start --ios --clear",
    "web": "expo start --web --clear"
  },
  "private": true
